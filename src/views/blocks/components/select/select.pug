mixin select(value = false)
    +b.input(class='_select '+value['parentClass'])
        if value['icon']
            +icon({
                name: value['icon'],
                class: value['iconClass'] ? 'input__icon ' + value['iconClass'] : 'input__icon'
            })
        +e.SELECT.placeholder.input__placeholder_select
            each option, index in value['options']
                +e.option(value=index data-select=option)
        +e.LABEL.label(data-title=value['options'][0])