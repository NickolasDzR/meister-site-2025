mixin input(value = false)
    +b.input(class=value.class)
        if value.icon
            +icon({
                name: value.icon,
                class: value.iconClass ? 'input__icon ' + value.iconClass : 'input__icon'
            })
        +e.INPUT.placeholder(class=value['placeholderClass'] placeholder=value['placeholder'])
        +e.LABEL.label(data-title=value['placeholder'])