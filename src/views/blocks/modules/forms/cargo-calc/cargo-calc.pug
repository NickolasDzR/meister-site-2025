mixin cargoCalc(value = false)
    +b.cargo-calc
        +closeButton({
            class: 'cargo-calc__close-button'
        })
        +e.form-wrapper
            +e.P.title= value['title']
            +e.form-inner
                +e.delivery-results
                    +e.delivery-results-wrapper
                    +button({
                        type: 'keppel',
                        class: 'cargo-calc__button-results',
                        text: 'Понятно',
                    })
                +e.FORM.form
                    +e.content
                        +select({
                            options: ['Выберете место загрузки'],
                            parentClass: 'cargo-calc__input',
                            icon: 'location',
                            name: 'location_0'
                        })
                        +select({
                            options: ['Выберете место выгрузки'],
                            parentClass: 'cargo-calc__input',
                            icon: 'location',
                            name: 'location_1'
                        })
                        +input({
                            placeholder: 'Тоннаж',
                            class: 'cargo-calc__input',
                            placeholderClass: 'cargo-calc__placeholder',
                            icon: 'weight',
                            iconClass: 'cargo-calc__placeholder-icon',
                            name: 'weight'
                        })
                        +button({
                            type: 'keppel',
                            class: 'cargo-calc__button',
                            text: 'Рассчитать доставку',
                        })
