mixin mainSlider(value = false)
    +b.main-slider
        if value.items
            +e.slider.splide(aria-labelledby="Слайдер со статьями")
                +e.arrows.splide__arrows
                    +e.BUTTON.arrow.main-slider__arrow-prev.splide__arrow.splide__arrow--prev
                        +e.SVG.svg-arrow(viewBox="0 0 12 20" width="12" height="20")
                            +e.PATH.svg-arrow-path(d="M11.0283 1.20798L2.39014 9.84619L11.0283 18.4844")
                    +e.slide-count= "1 / " + value["items"].length
                    // Нужно сделать анимацию заполнения кнопки нормально
                    +e.BUTTON.arrow.main-slider__arrow-next.splide__arrow.splide__arrow--next
                        +e.SVG.svg-arrow(viewBox="0 0 12 20" width="12" height="20")
                            +e.PATH.svg-arrow-path(d="M1.39011 1.26797L10.0283 9.90619L1.39011 18.5444")
                        +e.SVG.progress.splide__progress(viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg")
                            +e.CIRCLE.progress-bar(cx="50" cy="50" r="50")
                .splide__track
                    +e.UL.list.splide__list
                        each item in value.items
                            +e.LI.slide.splide__slide
                                +e.slide-container.container
                                    +e.row.row
                                        +e.content.col-12
                                            +e.title= item['title']
                                            +e.subtitle= item['subtitle']
                                            +e.A.article-link.button.button_transparent(href='#') Подробнее
                                        +picture({
                                            name: item["images"]["mobile"],
                                            md: true,
                                            class: "image"
                                        })